import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.sql.*;

public class TrainerBookingModule extends JFrame {
    private JComboBox<String> trainerDropdown;
    private JButton btnBook;

    public TrainerBookingModule() {
        setTitle("Trainer Booking");
        setSize(400, 200);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new FlowLayout());

        add(new JLabel("Select Trainer:"));
        trainerDropdown = new JComboBox<>();
        btnBook = new JButton("Book Trainer");
        add(trainerDropdown);
        add(btnBook);

        loadTrainers();

        btnBook.addActionListener(e -> bookTrainer());

        setVisible(true);
    }

    private void loadTrainers() {
        try (Connection con = DatabaseConnection.getConnection()) {
            String query = "SELECT name FROM trainers";
            Statement stmt = con.createStatement();
            ResultSet rs = stmt.executeQuery(query);

            while (rs.next()) {
                trainerDropdown.addItem(rs.getString("name"));
            }
        } catch (SQLException e) {
            JOptionPane.showMessageDialog(this, "Failed to load trainers!");
        }
    }

    private void bookTrainer() {
        try (Connection con = DatabaseConnection.getConnection()) {
            String trainerName = (String) trainerDropdown.getSelectedItem();
            String query = "INSERT INTO bookings (trainer_name, status) VALUES (?, ?)";
            PreparedStatement pst = con.prepareStatement(query);
            pst.setString(1, trainerName);
            pst.setString(2, "Confirmed");

            pst.executeUpdate();
            JOptionPane.showMessageDialog(this, "Trainer booked successfully!");
        } catch (SQLException e) {
            JOptionPane.showMessageDialog(this, "Booking failed! " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        new TrainerBookingModule();
    }
}
