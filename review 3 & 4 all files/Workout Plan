import javax.swing.*;
import java.awt.*;
import java.sql.*;

public class WorkoutModule extends JFrame {
    private JTextArea workoutPlan;
    private JButton btnSave;

    public WorkoutModule() {
        setTitle("Workout Plan");
        setSize(400, 300);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new BorderLayout());

        workoutPlan = new JTextArea();
        btnSave = new JButton("Save Plan");
        add(new JScrollPane(workoutPlan), BorderLayout.CENTER);
        add(btnSave, BorderLayout.SOUTH);

        btnSave.addActionListener(e -> saveWorkoutPlan());

        setVisible(true);
    }

    private void saveWorkoutPlan() {
        try (Connection con = DatabaseConnection.getConnection()) {
            String plan = workoutPlan.getText();
            String query = "INSERT INTO workout_plans (plan) VALUES (?)";
            PreparedStatement pst = con.prepareStatement(query);
            pst.setString(1, plan);

            pst.executeUpdate();
            JOptionPane.showMessageDialog(this, "Workout plan saved successfully!");
        } catch (SQLException e) {
            JOptionPane.showMessageDialog(this, "Failed to save plan!");
        }
    }

    public static void main(String[] args) {
        new WorkoutModule();
    }
}
