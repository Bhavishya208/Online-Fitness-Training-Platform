public static void bookTrainer(int userId, int trainerId) {
    try (Connection conn = DriverManager.getConnection("jdbc:mysql://localhost:3306/FitnessDB", "root", "password")) {
        String sql = "INSERT INTO Bookings(userId, trainerId, bookingDate) VALUES (?, ?, CURDATE())";
        PreparedStatement stmt = conn.prepareStatement(sql);
        stmt.setInt(1, userId);
        stmt.setInt(2, trainerId);

        int rows = stmt.executeUpdate();
        if (rows > 0) {
            System.out.println("Trainer booked successfully!");
        }
    } catch (SQLException e) {
        System.out.println("Booking Error: " + e.getMessage());
    }
}
