import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.assertj.swing.core.matcher.JButtonMatcher;
import org.assertj.swing.core.matcher.JTextComponentMatcher;
import org.assertj.swing.edt.GuiTask;
import org.assertj.swing.finder.WindowFinder;
import org.assertj.swing.fixture.FrameFixture;

import javax.swing.*;
import java.awt.*;

import static org.junit.jupiter.api.Assertions.*;

class LoginFormTest {

    private FrameFixture window;

    @BeforeEach
    void setUp() {
        // Assuming the LoginPage is a JFrame representing the login screen
        JFrame loginFrame = new LoginPage(); // Replace with actual LoginPage class
        window = new FrameFixture(loginFrame);
        window.show(); // Show the window for the test
    }

    @Test
    void testLoginButtonClick() {
        // Test if clicking the login button works
        window.textBox("emailField").enterText("john@example.com"); // Assuming email field has this name
        window.textBox("passwordField").enterText("password123"); // Assuming password field has this name

        // Simulate clicking the login button (assuming login button has this name)
        window.button(JButtonMatcher.withText("Login")).click();

        // Assuming after login, a new window or dialog opens (can add appropriate checks)
        window.dialog().requireVisible(); // Verify that the dialog opens
    }

    @Test
    void testInvalidLogin() {
        // Test invalid login
        window.textBox("emailField").enterText("invalid@example.com");
        window.textBox("passwordField").enterText("wrongpassword");

        window.button(JButtonMatcher.withText("Login")).click();

        // Check that the error message is shown (if this is the behavior in your app)
        window.label("errorMessage").requireText("Invalid credentials!"); // Assuming error label is named "errorMessage"
    }

    @Test
    void testEmptyEmailField() {
        // Test empty email field validation
        window.textBox("emailField").clear();
        window.textBox("passwordField").enterText("password123");

        window.button(JButtonMatcher.withText("Login")).click();

        // Check that an error is shown for missing email
        window.label("errorMessage").requireText("Email cannot be empty!");
    }

    @Test
    void testEmptyPasswordField() {
        // Test empty password field validation
        window.textBox("emailField").enterText("john@example.com");
        window.textBox("passwordField").clear();

        window.button(JButtonMatcher.withText("Login")).click();

        // Check that an error is shown for missing password
        window.label("errorMessage").requireText("Password cannot be empty!");
    }

    @Test
    void testUserRegistration() {
        // Assuming registration involves filling out multiple fields
        window.button("registerButton").click(); // Assuming register button clicks to registration form

        // Enter user details in the registration form
        window.textBox("nameField").enterText("John Doe");
        window.textBox("emailField").enterText("john@doe.com");
        window.textBox("passwordField").enterText("securepassword");
        window.textBox("confirmPasswordField").enterText("securepassword");

        // Click the submit button
        window.button("submitButton").click();

        // Check that registration is successful
        window.label("confirmationMessage").requireText("Registration successful!");
    }

    @Test
    void testInvalidEmailFormat() {
        // Test invalid email format during registration
        window.button("registerButton").click();

        window.textBox("emailField").enterText("invalid-email");
        window.button("submitButton").click();

        window.label("errorMessage").requireText("Invalid email format!");
    }

    @Test
    void testPasswordMismatch() {
        // Test password mismatch during registration
        window.button("registerButton").click();

        window.textBox("passwordField").enterText("password123");
        window.textBox("confirmPasswordField").enterText("password456");
        window.button("submitButton").click();

        window.label("errorMessage").requireText("Passwords do not match!");
    }

    @Test
    void testPasswordLengthValidation() {
        // Test password length validation
        window.button("registerButton").click();

        window.textBox("passwordField").enterText("short");
        window.textBox("confirmPasswordField").enterText("short");
        window.button("submitButton").click();

        window.label("errorMessage").requireText("Password must be at least 8 characters!");
    }
}
